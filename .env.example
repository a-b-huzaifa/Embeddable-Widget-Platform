# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/flyrank_widget_db

# Authentication / Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# Rate Limiting & Abuse Protection
RATE_LIMIT_IP_MAX=30
RATE_LIMIT_WIDGET_MAX=60

# Geolocation Fallback Providers
GEO_PROVIDER_A_URL=http://ip-api.com/json
GEO_PROVIDER_B_URL=https://ipapi.co
